<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="72dp" android:padding="8dp" android:gravity="center_vertical"
    android:background="?android:attr/activatedBackgroundIndicator">
    <ImageView android:id="@+id/icon" android:layout_width="40dp" android:layout_height="40dp"
        android:importantForAccessibility="no" android:layout_marginEnd="12dp" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/label" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="18sp" />
        <TextView android:id="@+id/package_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
