<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape>
                    <solid android:color="@color/reference_surface"/>
                    <stroke android:width="2dp" android:color="@color/reference_primary"/>
                    <corners android:radius="12dp"/>
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@color/reference_surface"/>
                    <stroke android:width="1dp" android:color="@color/reference_border"/>
                    <corners android:radius="12dp"/>
                </shape>
            </item>
        </selector>
    </item>
</ripple>
