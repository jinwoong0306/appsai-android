<resources>
    <style name="BaseAppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:statusBarColor">@color/canvas</item>
        <item name="android:navigationBarColor">@color/canvas</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
    <style name="AppTheme" parent="BaseAppTheme" />
    <style name="Page">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@color/canvas</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
    </style>
    <style name="BodyText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">17sp</item>
        <item name="android:breakStrategy">simple</item>
    </style>
    <style name="PageTitle" parent="BodyText">
        <item name="android:textSize">28sp</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>
    <style name="SectionTitle" parent="BodyText">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>
    <style name="SecondaryText" parent="BodyText">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/muted</item>
    </style>
    <style name="PrimaryButton" parent="android:style/Widget.Material.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:background">@drawable/bg_primary</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/primary_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="SecondaryButton" parent="PrimaryButton">
        <item name="android:background">@drawable/bg_choice</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="IconButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:tint">@color/ink</item>
    </style>
    <style name="InputField" parent="android:style/Widget.Material.EditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:padding">14dp</item>
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:textSize">17sp</item>
        <item name="android:singleLine">true</item>
    </style>
</resources>
