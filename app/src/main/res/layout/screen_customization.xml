<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="56dp" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageButton android:id="@+id/wardrobe_back" style="@style/IconButton"
            android:src="@drawable/ic_back" android:tint="@color/reference_ink"
            android:contentDescription="@string/navigate_back" android:tooltipText="@string/navigate_back"/>
        <TextView style="@style/WardrobeReferenceSection" android:layout_width="0dp"
            android:layout_weight="1" android:layout_marginTop="8dp" android:layout_marginBottom="8dp"
            android:textSize="20sp" android:gravity="center" android:text="@string/customize_title"/>
        <ImageButton android:id="@+id/open_settings" style="@style/IconButton"
            android:src="@drawable/ic_settings" android:tint="@color/reference_ink"
            android:contentDescription="@string/settings_title" android:tooltipText="@string/settings_title"/>
        <ImageButton android:id="@+id/feature_help" style="@style/IconButton"
            android:src="@drawable/ic_help" android:contentDescription="@string/help_open"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginBottom="8dp">
        <Button android:id="@+id/wardrobe_friend" style="@style/WardrobeReferenceTab"
            android:layout_width="0dp" android:layout_weight="1"
            android:contentDescription="@string/customize_select"/>
        <Button android:id="@+id/wardrobe_cancel" style="@style/WardrobeReferenceTab"
            android:layout_width="wrap_content" android:layout_marginStart="8dp"
            android:text="@string/customize_reset"/>
    </LinearLayout>
    <TextView android:id="@+id/wardrobe_empty" style="@style/WardrobeReferenceText"
        android:layout_height="0dp" android:layout_weight="1" android:gravity="center"
        android:text="@string/wardrobe_reference_empty" android:visibility="gone"/>
    <RelativeLayout android:id="@+id/wardrobe_content" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/wardrobe_preview_row"
            android:layout_width="match_parent" android:layout_height="@dimen/wardrobe_stage_height"
            android:baselineAligned="false"
            android:orientation="horizontal" android:layout_marginBottom="8dp">
            <FrameLayout android:id="@+id/wardrobe_scene" android:layout_width="0dp"
                android:layout_weight="3" android:layout_height="match_parent"
                android:background="@drawable/bg_reference_preview">
                <ImageView android:id="@+id/wardrobe_scene_art" android:layout_width="match_parent"
                    android:layout_height="match_parent" android:scaleType="centerCrop"
                    android:importantForAccessibility="no"/>
                <kr.example.haliltalk.character.CharacterView android:id="@+id/wardrobe_preview"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:padding="8dp" android:importantForAccessibility="no"/>
            </FrameLayout>
            <ScrollView android:layout_width="0dp" android:layout_weight="2"
                android:layout_height="match_parent" android:layout_marginStart="8dp"
                android:background="@drawable/bg_reference_card" android:fillViewport="true">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="8dp">
                    <TextView style="@style/WardrobeReferenceText"
                        android:textStyle="bold" android:gravity="center" android:padding="4dp"
                        android:background="@drawable/bg_reference_chip"
                        android:textColor="@color/reference_purple_ink"
                        android:text="@string/wardrobe_reference_equipped"/>
                    <TextView android:id="@+id/wardrobe_equipped" style="@style/WardrobeReferenceText"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
        <ScrollView android:id="@+id/wardrobe_scroll" android:layout_width="match_parent"
            android:layout_height="match_parent" android:layout_below="@id/wardrobe_preview_row"
            android:fillViewport="true"
            android:clipToPadding="false">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingBottom="12dp">
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:scrollbars="none">
                    <LinearLayout android:id="@+id/wardrobe_tabs" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:orientation="horizontal"/>
                </HorizontalScrollView>
                <TextView android:id="@+id/wardrobe_inventory_title" style="@style/WardrobeReferenceSection"/>
                <TextView android:id="@+id/wardrobe_owned" style="@style/WardrobeReferenceText"
                    android:textColor="@color/reference_muted"
                    android:layout_marginBottom="8dp"/>
                <HorizontalScrollView android:id="@+id/wardrobe_inventory_scroll"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:scrollbars="horizontal" android:fillViewport="false">
                    <kr.example.haliltalk.AccessoryGrid android:id="@+id/wardrobe_items"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="horizontal"/>
                </HorizontalScrollView>
                <TextView style="@style/WardrobeReferenceSection" android:text="@string/wardrobe_reference_backgrounds"/>
                <TextView style="@style/WardrobeReferenceText"
                    android:textColor="@color/reference_muted" android:text="@string/wardrobe_reference_starters"
                    android:layout_marginBottom="8dp"/>
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:scrollbars="horizontal" android:fillViewport="false">
                    <kr.example.haliltalk.AccessoryGrid android:id="@+id/wardrobe_backgrounds"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="horizontal"/>
                </HorizontalScrollView>
                <TextView style="@style/WardrobeReferenceSection" android:text="@string/character_selection"/>
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:scrollbars="none">
                    <LinearLayout android:id="@+id/wardrobe_characters" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:orientation="horizontal"/>
                </HorizontalScrollView>
            </LinearLayout>
        </ScrollView>
    </RelativeLayout>
    <LinearLayout android:id="@+id/wardrobe_actions" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/wardrobe_save_error" style="@style/WardrobeReferenceText"
            android:textColor="@color/reference_danger" android:accessibilityLiveRegion="polite"
            android:visibility="gone"/>
        <Button android:id="@+id/wardrobe_save" style="@style/ReferenceAction"
            android:layout_marginTop="8dp" android:layout_marginBottom="8dp"
            android:background="@drawable/bg_reference_action" android:textSize="20sp"
            android:textStyle="bold"
            android:text="@string/wardrobe_reference_save"/>
    </LinearLayout>
    <include layout="@layout/bottom_navigation"/>
</LinearLayout>
