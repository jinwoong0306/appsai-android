<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" style="@style/Page" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView style="@style/SectionTitle" android:layout_width="0dp" android:layout_weight="1" android:text="@string/customize_title"/>
        <ImageButton android:id="@+id/open_settings" style="@style/IconButton" android:src="@drawable/ic_settings" android:contentDescription="@string/settings_title"/>
    </LinearLayout>
    <Button android:id="@+id/wardrobe_friend" style="@style/SecondaryButton" android:contentDescription="@string/customize_select"/>
    <TextView android:id="@+id/wardrobe_empty" style="@style/BodyText" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:text="@string/customize_empty" android:visibility="gone"/>
    <LinearLayout android:id="@+id/wardrobe_content" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
        <kr.example.haliltalk.character.CharacterView android:id="@+id/wardrobe_preview" android:layout_width="match_parent" android:layout_height="152dp" android:background="@drawable/bg_hero" android:padding="8dp"/>
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView style="@style/SectionTitle" android:text="@string/character_selection"/>
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
                    <LinearLayout android:id="@+id/wardrobe_characters" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"/>
                </HorizontalScrollView>
                <TextView style="@style/SectionTitle" android:text="@string/accessory_selection"/>
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
                    <LinearLayout android:id="@+id/wardrobe_tabs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"/>
                </HorizontalScrollView>
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:layout_marginBottom="12dp">
                    <LinearLayout android:id="@+id/wardrobe_items" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"/>
                </HorizontalScrollView>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
    <LinearLayout android:id="@+id/wardrobe_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/wardrobe_cancel" style="@style/SecondaryButton" android:layout_width="0dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:text="@string/customize_reset"/>
        <Button android:id="@+id/wardrobe_save" style="@style/PrimaryButton" android:layout_width="0dp" android:layout_weight="1" android:text="@string/customize_save"/>
    </LinearLayout>
    <include layout="@layout/bottom_navigation"/>
</LinearLayout>
