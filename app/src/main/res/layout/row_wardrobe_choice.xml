<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="100dp" android:layout_height="wrap_content"
    android:layout_marginEnd="8dp" android:minHeight="112dp"
    android:orientation="vertical" android:padding="8dp"
    android:background="@drawable/wardrobe_choice" android:clickable="true" android:focusable="true">
    <FrameLayout android:layout_width="match_parent" android:layout_height="64dp"
        android:background="@drawable/bg_reference_thumbnail">
        <kr.example.haliltalk.character.CharacterView android:id="@+id/choice_character"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:importantForAccessibility="no"/>
        <ImageView android:id="@+id/wardrobe_item_image" android:layout_width="match_parent"
            android:layout_height="match_parent" android:scaleType="fitCenter"
            android:importantForAccessibility="no" android:visibility="gone"/>
        <ImageView android:id="@+id/choice_check" android:layout_width="24dp"
            android:layout_height="24dp" android:layout_gravity="top|end"
            android:src="@drawable/wardrobe_check" android:importantForAccessibility="no"
            android:visibility="invisible"/>
        <ImageView android:id="@+id/choice_lock" android:layout_width="24dp"
            android:layout_height="24dp" android:layout_gravity="top|end"
            android:src="@drawable/ic_reference_lock" android:importantForAccessibility="no"
            android:visibility="gone"/>
    </FrameLayout>
    <TextView android:id="@+id/choice_label" style="@style/WardrobeReferenceText"
        android:layout_marginTop="4dp" android:gravity="center"/>
</LinearLayout>
