<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Page" android:orientation="vertical">
    <Button android:id="@+id/goals_back" style="@style/SecondaryButton" android:text="@string/goals_back" />
    <TextView android:id="@+id/goals_title" style="@style/SectionTitle" android:text="@string/goals_title" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">
            <Button android:id="@+id/add_goal" style="@style/PrimaryButton" android:text="@string/goals_add" />
            <TextView android:id="@+id/goals_error" style="@style/SecondaryText"
                android:accessibilityLiveRegion="polite" android:visibility="gone" />
            <LinearLayout android:id="@+id/goals_list" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
