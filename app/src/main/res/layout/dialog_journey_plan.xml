<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView style="@style/SecondaryText" android:text="@string/journey_action_label"
            android:labelFor="@id/journey_action_input"/>
        <EditText android:id="@+id/journey_action_input" style="@style/InputField"
            android:inputType="textCapSentences" android:importantForAutofill="no" android:maxLength="120"/>
        <TextView style="@style/SecondaryText" android:text="@string/journey_action_hint"/>
        <Button android:id="@+id/journey_suggest" style="@style/SecondaryButton"
            android:text="@string/journey_suggest"/>
        <TextView style="@style/SecondaryText" android:text="@string/journey_cue_label"
            android:labelFor="@id/journey_cue_input" android:layout_marginTop="12dp"/>
        <EditText android:id="@+id/journey_cue_input" style="@style/InputField"
            android:inputType="textCapSentences" android:importantForAutofill="no" android:maxLength="80"/>
        <TextView style="@style/SecondaryText" android:text="@string/journey_cue_hint"/>
        <TextView style="@style/SecondaryText" android:text="@string/journey_goal_label"
            android:labelFor="@id/journey_goal_input" android:layout_marginTop="12dp"/>
        <Spinner android:id="@+id/journey_goal_input" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp" android:spinnerMode="dialog"/>
        <Button android:id="@+id/journey_repeat" style="@style/SecondaryButton"
            android:text="@string/journey_repeat" android:visibility="gone"/>
        <TextView android:id="@+id/journey_dialog_error" style="@style/SecondaryText"
            android:accessibilityLiveRegion="polite" android:visibility="gone"/>
    </LinearLayout>
</ScrollView>
