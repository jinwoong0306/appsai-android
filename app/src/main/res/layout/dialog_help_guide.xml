<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/help_normal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/help_back"
                style="@style/HelpGuideSmallAction"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/help_back" />
            <Button
                android:id="@+id/help_close"
                style="@style/HelpGuideSmallAction"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/help_close" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/help_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="8dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/help_title"
                    style="@style/SectionTitle"
                    android:layout_marginTop="8dp" />
                <LinearLayout
                    android:id="@+id/help_questions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
                <LinearLayout
                    android:id="@+id/help_tutorial"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <TextView
                        android:id="@+id/help_progress"
                        style="@style/SecondaryText"
                        android:accessibilityLiveRegion="polite" />
                    <TextView
                        android:id="@+id/help_headline"
                        style="@style/SectionTitle"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp" />
                    <ImageView
                        android:id="@+id/help_image"
                        android:contentDescription="@string/help_image_hint"
                        android:layout_width="match_parent"
                        android:layout_height="360dp"
                        android:background="@color/canvas"
                        android:clickable="true"
                        android:focusable="true"
                        android:scaleType="fitCenter" />
                    <TextView
                        style="@style/SecondaryText"
                        android:gravity="center"
                        android:text="@string/help_image_hint" />
                    <TextView
                        android:id="@+id/help_body"
                        style="@style/BodyText"
                        android:layout_marginTop="8dp" />
                    <Button
                        android:id="@+id/help_details_toggle"
                        style="@style/SecondaryButton"
                        android:text="@string/help_details_show" />
                    <TextView
                        android:id="@+id/help_details"
                        style="@style/BodyText"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/help_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">
            <Button
                android:id="@+id/help_previous"
                style="@style/HelpGuideSmallAction"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/help_previous" />
            <Button
                android:id="@+id/help_next"
                style="@style/HelpGuideSmallAction"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/help_next" />
        </LinearLayout>
        <Button
            android:id="@+id/help_skip"
            style="@style/HelpGuideSmallAction"
            android:text="@string/help_skip"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/help_zoom"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:visibility="gone">
        <Button
            android:id="@+id/help_zoom_close"
            style="@style/HelpGuideSmallAction"
            android:text="@string/help_zoom_close" />
        <TextView
            android:id="@+id/help_zoom_title"
            style="@style/SecondaryText"
            android:gravity="center" />
        <kr.example.haliltalk.GuideImageView
            android:id="@+id/help_zoom_image"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:focusable="true" />
        <TextView
            style="@style/SecondaryText"
            android:gravity="center"
            android:text="@string/help_zoom_hint" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/help_zoom_out"
                style="@style/HelpGuideSmallAction"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/help_zoom_out" />
            <Button
                android:id="@+id/help_zoom_reset"
                style="@style/HelpGuideSmallAction"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/help_zoom_reset" />
            <Button
                android:id="@+id/help_zoom_in"
                style="@style/HelpGuideSmallAction"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/help_zoom_in" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
