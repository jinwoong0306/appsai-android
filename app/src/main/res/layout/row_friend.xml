<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:minHeight="88dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:background="@drawable/bg_reference_card"
    android:clickable="true"
    android:focusable="true">

    <kr.example.haliltalk.character.CharacterView
        android:id="@+id/friend_character"
        android:layout_width="64dp"
        android:layout_height="72dp"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="8dp" android:paddingEnd="0dp">
        <LinearLayout android:id="@+id/friend_heading" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView android:id="@+id/friend_label" style="@style/ReferenceCopy" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:textSize="20sp" android:fontFamily="@font/jua_regular" android:textColor="@color/reference_ink"
                android:maxLines="2" android:ellipsize="end"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/friend_message_line" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:orientation="vertical">
            <TextView android:id="@+id/friend_preview" style="@style/ReferenceCopy" android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/reference_muted"
                android:textSize="15sp" android:maxLines="2" android:ellipsize="end"
                />
        </LinearLayout>
    </LinearLayout>
    <!-- Count and time reserve their own width, independent of long names and previews. -->
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="8dp" android:orientation="vertical" android:gravity="end">
        <TextView android:id="@+id/friend_time" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:maxWidth="96dp"
            android:maxLines="2" android:ellipsize="end"
            android:textSize="12sp" android:textColor="@color/reference_muted"/>
        <TextView android:id="@+id/friend_unread" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:minWidth="24dp" android:minHeight="24dp"
            android:layout_marginTop="6dp" android:paddingStart="6dp" android:paddingEnd="6dp"
            android:gravity="center" android:fontFamily="@font/jua_regular" android:textSize="14sp"
            android:maxLines="1"
            android:textColor="@android:color/white" android:background="@drawable/bg_unread"
            android:visibility="gone" android:importantForAccessibility="no"/>
    </LinearLayout>
</LinearLayout>
