<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Page" android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/back_home"
            style="@style/IconButton"
            android:drawableStart="@drawable/ic_back"
            android:contentDescription="@string/back_to_friends" />

        <TextView
            style="@style/SectionTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:text="@string/brand_name" />

        <Space
            android:layout_width="48dp"
            android:layout_height="1dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="@drawable/bg_hero">

        <kr.example.haliltalk.character.CharacterView
            android:id="@+id/chat_character"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp" android:paddingEnd="0dp">

            <TextView
                android:id="@+id/chat_title"
                style="@style/PageTitle"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/chat_personality"
                style="@style/SecondaryText" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/open_goals"
        style="@style/SecondaryButton"
        android:layout_marginTop="0dp"
        android:text="@string/goals_open" />

    <Button
        android:id="@+id/check_usage"
        style="@style/SecondaryButton"
        android:layout_marginTop="0dp"
        android:text="@string/check_usage" />

    <TextView
        android:id="@+id/ai_notice"
        style="@style/SecondaryText"
        android:layout_marginBottom="12dp"
        android:minHeight="48dp"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:text="@string/ai_notice" />

    <TextView
        android:id="@+id/ai_status"
        style="@style/SecondaryText"
        android:accessibilityLiveRegion="polite"
        android:gravity="center"
        android:text="@string/ai_ready" />

    <ProgressBar
        android:id="@+id/ai_progress"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center_horizontal"
        android:contentDescription="@string/ai_loading"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button
            android:id="@+id/retry_message"
            style="@style/SecondaryButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/ai_retry"
            android:visibility="gone" />
        <Button
            android:id="@+id/cancel_request"
            style="@style/SecondaryButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/ai_cancel_request"
            android:visibility="gone" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/chat_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/message_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        style="@style/SecondaryText"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:labelFor="@id/message_input"
        android:text="@string/message_label" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/message_input"
            style="@style/InputField"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:singleLine="false"
            android:maxLines="4"
            android:inputType="textCapSentences|textMultiLine"
            android:imeOptions="actionSend"
            android:hint="@string/message_hint"
            android:autofillHints="" />

        <Button
            android:id="@+id/send_message"
            style="@style/PrimaryButton"
            android:layout_width="wrap_content"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="0dp"
            android:text="@string/send_message" />
    </LinearLayout>
</LinearLayout>
