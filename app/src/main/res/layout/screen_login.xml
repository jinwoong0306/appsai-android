<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Page" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center_horizontal"
        android:paddingTop="24dp" android:paddingBottom="24dp">
        <TextView style="@style/PageTitle" android:gravity="center" android:text="@string/app_name"/>
        <TextView style="@style/SecondaryText" android:gravity="center"
            android:text="@string/login_tagline" android:layout_marginBottom="24dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center"
            android:background="@drawable/bg_hero" android:padding="24dp">
            <kr.example.haliltalk.character.CharacterView android:id="@+id/login_character"
                android:layout_width="200dp" android:layout_height="200dp"
                android:importantForAccessibility="no"/>
            <TextView style="@style/SectionTitle" android:gravity="center"
                android:text="@string/login_greeting"/>
            <TextView style="@style/BodyText" android:gravity="center"
                android:text="@string/login_description" android:layout_marginBottom="12dp"/>
        </LinearLayout>
        <Space android:layout_width="1dp" android:layout_height="24dp"/>
        <Button android:id="@+id/login_button" style="@style/PrimaryButton"
            android:text="@string/mock_login"/>
        <TextView style="@style/SecondaryText" android:gravity="center"
            android:layout_marginTop="8dp" android:text="@string/mock_login_notice"/>
        <TextView style="@style/SecondaryText" android:gravity="center"
            android:layout_marginTop="20dp" android:text="@string/login_notifications_optional"/>
    </LinearLayout>
</ScrollView>
