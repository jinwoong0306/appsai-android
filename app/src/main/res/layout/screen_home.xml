<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Page" android:paddingStart="16dp" android:paddingEnd="16dp"
    android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView style="@style/PageTitle" android:layout_width="0dp"
            android:layout_weight="1" android:text="@string/brand_name"/>
        <ImageButton android:id="@+id/home_help" style="@style/IconButton"
            android:src="@drawable/ic_help" android:contentDescription="@string/help_open"/>
        <ImageButton android:id="@+id/open_settings" style="@style/IconButton"
            android:src="@drawable/ic_settings" android:contentDescription="@string/settings_title"/>
    </LinearLayout>
    <ScrollView android:id="@+id/home_scroll" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingBottom="12dp">
            <FrameLayout android:id="@+id/home_reference_header" android:layout_width="match_parent"
                android:layout_height="@dimen/scene_height" android:background="@drawable/bg_scene_frame"
                android:importantForAccessibility="noHideDescendants">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                    android:src="@drawable/scene_garden" android:scaleType="centerCrop" android:importantForAccessibility="no"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_gravity="bottom" android:gravity="center" android:orientation="horizontal"
                    android:paddingBottom="8dp">
                    <kr.example.haliltalk.character.CharacterView android:id="@+id/home_hero_reading"
                        android:layout_width="0dp" android:layout_weight="1" android:layout_height="80dp"/>
                    <kr.example.haliltalk.character.CharacterView android:id="@+id/home_hero_video"
                        android:layout_width="0dp" android:layout_weight="1" android:layout_height="80dp"/>
                    <kr.example.haliltalk.character.CharacterView android:id="@+id/home_hero_fitness"
                        android:layout_width="0dp" android:layout_weight="1" android:layout_height="80dp"/>
                    <kr.example.haliltalk.character.CharacterView android:id="@+id/home_character"
                        android:layout_width="0dp" android:layout_weight="1" android:layout_height="80dp"/>
                </LinearLayout>
            </FrameLayout>
            <LinearLayout android:id="@+id/home_guide_card" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="horizontal"
                android:gravity="center_vertical" android:padding="8dp" android:layout_marginTop="12dp"
                android:background="@drawable/bg_reference_preview" android:visibility="gone">
                <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView style="@style/SecondaryText" android:text="@string/home_guide_title"/>
                    <Button android:id="@+id/home_guide_start" style="@style/CompactAction"
                        android:text="@string/home_guide_start"/>
                </LinearLayout>
                <Button android:id="@+id/home_guide_skip" style="@style/CompactAction"
                    android:text="@string/home_guide_skip"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp" android:layout_marginTop="12dp"
                android:background="@drawable/bg_reference_card">
                <TextView style="@style/SecondaryText" android:text="@string/home_today_heading"/>
                <TextView android:id="@+id/home_journey_next" style="@style/BodyText"
                    android:fontFamily="@font/jua_regular" android:textSize="20sp"
                    android:layout_marginTop="8dp"/>
                <TextView android:id="@+id/home_journey_summary" style="@style/SecondaryText"
                    android:layout_marginTop="6dp"/>
                <Button android:id="@+id/home_journey" style="@style/ReferenceAction"
                    android:text="@string/journey_open"/>
                <Button android:id="@+id/home_adventure" style="@style/SecondaryButton"
                    android:text="@string/adventure_title"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginTop="16dp" android:layout_marginBottom="8dp">
                <TextView style="@style/SectionTitle" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_marginTop="0dp"
                    android:layout_marginBottom="0dp" android:text="@string/home_friends_heading"/>
                <Button android:id="@+id/home_new_friend" style="@style/CompactAction"
                    android:text="@string/home_new_friend"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/friend_list" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"/>
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/bottom_navigation"/>
</LinearLayout>
