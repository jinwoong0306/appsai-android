<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Page" android:orientation="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
    <Space android:layout_width="48dp" android:layout_height="1dp"/>
    <TextView
        style="@style/SectionTitle"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:minHeight="48dp"
        android:gravity="center"
        android:text="@string/brand_name" />
    <ImageButton android:id="@+id/open_settings" style="@style/IconButton" android:src="@drawable/ic_settings" android:contentDescription="@string/settings_title"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="160dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:background="@drawable/bg_hero">

                <TextView
                    style="@style/PageTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="0dp"
                    android:layout_marginBottom="0dp"
                    android:text="@string/home_title" />

                <kr.example.haliltalk.character.CharacterView
                    android:id="@+id/home_character"
                    android:layout_width="100dp"
                    android:layout_height="128dp"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <TextView
                style="@style/SecondaryText"
                android:layout_marginTop="12dp"
                android:text="@string/home_description" />

            <TextView
                style="@style/SectionTitle"
                android:text="@string/my_app_friends" />

            <LinearLayout
                android:id="@+id/friend_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/bottom_navigation" />
</LinearLayout>
