<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Page" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageButton android:id="@+id/wardrobe_back" style="@style/IconButton"
            android:src="@drawable/ic_back" android:contentDescription="@string/navigate_back"/>
        <TextView style="@style/SectionTitle" android:layout_width="0dp" android:layout_weight="1"
            android:layout_marginTop="0dp" android:layout_marginBottom="0dp" android:text="@string/customize_title"/>
        <ImageButton android:id="@+id/open_settings" style="@style/IconButton"
            android:src="@drawable/ic_settings" android:contentDescription="@string/settings_title"/>
        <ImageButton android:id="@+id/feature_help" style="@style/IconButton"
            android:src="@drawable/ic_help" android:contentDescription="@string/help_open"/>
    </LinearLayout>
    <TextView android:id="@+id/wardrobe_empty" style="@style/WardrobeReferenceText"
        android:layout_height="0dp" android:layout_weight="1" android:gravity="center"
        android:text="@string/wardrobe_reference_empty" android:visibility="gone"/>
    <GridLayout android:id="@+id/wardrobe_content" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:columnCount="2" android:rowCount="1">
        <ScrollView android:layout_width="0dp" android:layout_columnWeight="2"
            android:layout_height="match_parent" android:layout_marginEnd="16dp">
            <LinearLayout android:id="@+id/wardrobe_preview_row" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical">
                <Button android:id="@+id/wardrobe_friend" style="@style/WardrobeReferenceTab"
                    android:contentDescription="@string/customize_select"/>
                <FrameLayout android:id="@+id/wardrobe_scene" android:layout_width="match_parent"
                    android:layout_height="112dp" android:background="@drawable/bg_reference_preview">
                    <ImageView android:id="@+id/wardrobe_scene_art" android:layout_width="match_parent"
                        android:layout_height="match_parent" android:scaleType="centerCrop"
                        android:importantForAccessibility="no"/>
                    <kr.example.haliltalk.character.CharacterView android:id="@+id/wardrobe_preview"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:importantForAccessibility="no"/>
                </FrameLayout>
                <Button android:id="@+id/wardrobe_cancel" style="@style/WardrobeReferenceTab"
                    android:text="@string/customize_reset"/>
                <TextView android:id="@+id/wardrobe_equipped" style="@style/WardrobeReferenceText"/>
            </LinearLayout>
        </ScrollView>
        <ScrollView android:id="@+id/wardrobe_scroll" android:layout_width="0dp"
            android:layout_columnWeight="3" android:layout_height="match_parent">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingBottom="12dp">
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout android:id="@+id/wardrobe_tabs" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:orientation="horizontal"/>
                </HorizontalScrollView>
                <TextView android:id="@+id/wardrobe_inventory_title" style="@style/WardrobeReferenceSection"/>
                <TextView android:id="@+id/wardrobe_owned" style="@style/WardrobeReferenceText"/>
                <HorizontalScrollView android:id="@+id/wardrobe_inventory_scroll"
                    android:layout_width="match_parent" android:layout_height="wrap_content">
                    <kr.example.haliltalk.AccessoryGrid android:id="@+id/wardrobe_items"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="horizontal"/>
                </HorizontalScrollView>
                <TextView style="@style/WardrobeReferenceSection" android:text="@string/wardrobe_reference_backgrounds"/>
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
                    <kr.example.haliltalk.AccessoryGrid android:id="@+id/wardrobe_backgrounds"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="horizontal"/>
                </HorizontalScrollView>
                <TextView style="@style/WardrobeReferenceSection" android:text="@string/character_selection"/>
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout android:id="@+id/wardrobe_characters" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:orientation="horizontal"/>
                </HorizontalScrollView>
            </LinearLayout>
        </ScrollView>
    </GridLayout>
    <LinearLayout android:id="@+id/wardrobe_actions" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/wardrobe_save_error" style="@style/WardrobeReferenceText"
            android:textColor="@color/reference_danger" android:accessibilityLiveRegion="polite" android:visibility="gone"/>
        <Button android:id="@+id/wardrobe_save" style="@style/ReferenceAction"
            android:text="@string/wardrobe_reference_save"/>
    </LinearLayout>
    <include layout="@layout/bottom_navigation"/>
</LinearLayout>
