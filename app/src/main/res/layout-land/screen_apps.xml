<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Page" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <Button android:id="@+id/apps_back" style="@style/IconButton"
            android:drawableStart="@drawable/ic_back" android:contentDescription="@string/navigate_back"/>
        <TextView style="@style/SectionTitle" android:layout_width="0dp" android:layout_weight="1"
            android:layout_marginTop="0dp" android:layout_marginBottom="0dp" android:text="@string/available_apps"/>
        <ImageButton android:id="@+id/open_settings" style="@style/IconButton"
            android:src="@drawable/ic_settings" android:contentDescription="@string/settings_title"/>
    </LinearLayout>
    <GridLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:columnCount="2" android:rowCount="1">
        <ScrollView android:layout_width="0dp" android:layout_columnWeight="2" android:layout_height="match_parent"
            android:layout_marginEnd="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <kr.example.haliltalk.character.CharacterView android:id="@+id/picker_character"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:importantForAccessibility="no"/>
                <TextView style="@style/SecondaryText"
                    android:text="@string/app_search_label"/>
                <EditText android:id="@+id/app_search" style="@style/InputField"
                    android:hint="@string/app_search_hint" android:inputType="text"
                    android:imeOptions="actionSearch" android:autofillHints=""/>
                <TextView android:id="@+id/apps_count" style="@style/SecondaryText"
                    android:accessibilityLiveRegion="polite"/>
            </LinearLayout>
        </ScrollView>
        <LinearLayout android:layout_width="0dp" android:layout_columnWeight="3" android:layout_height="match_parent"
            android:orientation="vertical">
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <TextView android:id="@+id/apps_empty" style="@style/SecondaryText"
                    android:text="@string/apps_empty" android:visibility="gone"/>
                <ListView android:id="@+id/app_list" android:layout_width="match_parent"
                    android:layout_height="match_parent" android:divider="@android:color/transparent"
                    android:dividerHeight="8dp"/>
            </FrameLayout>
            <Button android:id="@+id/apps_continue" style="@style/PrimaryButton"
                android:enabled="false" android:text="@string/apps_continue"/>
        </LinearLayout>
    </GridLayout>
    <include layout="@layout/bottom_navigation"/>
</LinearLayout>
